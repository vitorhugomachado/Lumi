NEXT_PUBLIC_VOICE_PROVIDER=mock
# Troque por gemini para testar voz no servidor local.
# Chave exclusivamente no servidor. Nunca use NEXT_PUBLIC_GEMINI_API_KEY.
GEMINI_API_KEY=

# No Railway, use a referencia privada ${{Postgres.DATABASE_URL}} no servico Lumi.
# Deixe vazio para continuar usando o modo local sem conta.
DATABASE_URL=
# Origem HTTPS exata da aplicacao hospedada, sem barra final.
APP_ORIGIN=

# Optional transactional email (server only)
RESEND_API_KEY=
MAIL_FROM=
